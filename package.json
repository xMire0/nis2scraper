    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "prettier": "^3.9.8",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
