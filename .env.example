DATABASE_URL=postgresql://nis2:nis2_local_development@127.0.0.1:55432/nis2
DIRECT_URL=postgresql://nis2:nis2_local_development@127.0.0.1:55432/nis2
# Server-only CVRbasen API key. Never use NEXT_PUBLIC for this key.
CVRBASEN_API_KEY=
# Server-only OpenAI Responses API with web search (paid tokens + search).
OPENAI_API_KEY=
OPENAI_WEBSITE_MODEL=gpt-4.1-mini
# UTC daily request attempts, including failures. 0 pauses new paid searches.
OPENAI_WEBSITE_MAX_REQUESTS_PER_DAY=10
# Required outside local development. Set a long unique password.
APP_PASSWORD=
