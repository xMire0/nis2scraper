DATABASE_URL=postgresql://nis2:nis2_local_development@127.0.0.1:55432/nis2
DIRECT_URL=postgresql://nis2:nis2_local_development@127.0.0.1:55432/nis2
# Registry provider: cvrbasen (default) or apicvr.
# cvrbasen: Find virksomheder + Opdater CVR + regnskab (requires CVRBASEN_API_KEY).
# apicvr: Opdater CVR only (no industry search, no statements). Public ApiCVR needs no key.
CVR_REGISTRY_PROVIDER=cvrbasen
# Server-only CVRbasen API key. Never use NEXT_PUBLIC for this key.
CVRBASEN_API_KEY=
# Optional ApiCVR base URL (default https://apicvr.dk). Used when CVR_REGISTRY_PROVIDER=apicvr.
APICVR_BASE_URL=https://apicvr.dk
# Optional bearer for a private/self-hosted ApiCVR instance. Public apicvr.dk needs none.
APICVR_API_KEY=
# Server-only OpenAI Responses API with web search (paid tokens + search).
OPENAI_API_KEY=
OPENAI_WEBSITE_MODEL=gpt-4.1-mini
# UTC daily request attempts, including failures. 0 pauses new paid searches.
OPENAI_WEBSITE_MAX_REQUESTS_PER_DAY=10
# Required outside local development. Set a long unique password.
APP_PASSWORD=
